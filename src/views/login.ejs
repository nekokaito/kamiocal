<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />

    <title>Protected Folder | Kamiocal</title>
    <link rel="stylesheet" href="/styles/style.css" />
  </head>

  <body class="login-page">
    <main class="login-card">
      <div class="login-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </div>

      <h1 class="login-title">Protected Folder</h1>

      <p class="login-description">
        This folder is password protected. Enter the password to access shared
        files.
      </p>

      <form action="/login" method="POST">
        <input
          type="text"
          name="username"
          autocomplete="username"
          value=""
          hidden
        />

        <label class="login-label" for="password"> Password </label>

        <input
          class="login-input"
          id="password"
          name="password"
          type="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
          autofocus
          <%
          if
          (locals.error)
          {
          %
        />
        aria-invalid="true" aria-describedby="login-error" <% } %> /> <% if
        (locals.error) { %>
        <p class="login-error" id="login-error" role="alert">
          Incorrect password. Please try again.
        </p>
        <% } %>

        <button class="login-button" type="submit">Unlock Folder</button>
      </form>

      <p class="login-footer">Powered by Kamiocal</p>
    </main>
  </body>
</html>
